{
  "name": "waylog",
  "displayName": "WayLog - Save & Export AI Chat History",
  "description": "Sync and backup AI chat history from Cursor, VS Code, Lingma, and CodeBuddy. Export conversations to Markdown and build your team's AI knowledge base.",
  "version": "0.0.10",
  "icon": "images/icon.png",
  "publisher": "waylog",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shayne-snap/WayLog.git"
  },
  "bugs": {
    "url": "https://github.com/shayne-snap/WayLog/issues"
  },
  "homepage": "https://github.com/shayne-snap/WayLog#readme",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "chat",
    "history",
    "cursor",
    "copilot",
    "backup",
    "export",
    "markdown",
    "lingma",
    "codebuddy",
    "cline",
    "roo-code",
    "knowledge-base"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "waylog.saveHistory",
        "title": "Save AI Chat History 💾",
        "category": "WayLog",
        "icon": "$(save)"
      }
    ],
    "configuration": {
      "title": "WayLog",
      "properties": {
        "waylog.enable": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable or disable all WayLog features."
        },
        "waylog.autoSave": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Enable automatic background saving of chat history."
        },
        "waylog.autoSaveInterval": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "scope": "window",
          "description": "Interval in seconds between automatic history syncs."
        },
        "waylog.codebuddyChannel": {
          "type": "string",
          "enum": ["auto", "VSCode", "CodeBuddyIDE", "all"],
          "default": "auto",
          "scope": "window",
          "description": "Which CodeBuddy product history to read. auto uses only the current IDE (VS Code extension or CodeBuddy IDE); all reads every product channel."
        },
        "waylog.codebuddyDataPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "window",
          "description": "Extra CodeBuddy data roots to search. Empty uses the automatically detected platform roots."
        },
        "waylog.codebuddyHistoryDir": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Force a specific CodeBuddy history directory and skip automatic discovery. Empty means auto."
        },
        "waylog.codebuddyWorkspacePath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Override the workspace path used to locate CodeBuddy history (useful after renaming or in remote setups). Empty means the open workspace."
        },
        "waylog.outputDir": {
          "type": "string",
          "default": ".waylog/history",
          "scope": "window",
          "description": "Directory for exported Markdown files. Relative paths are resolved against the workspace; supports ${workspaceFolder} and {source}/{date} placeholders."
        },
        "waylog.filenameTemplate": {
          "type": "string",
          "default": "{date}_{time}Z-{title}.md",
          "scope": "window",
          "description": "Filename template for exports. Placeholders: {date}, {time}, {title}, {source}, {workspace}, {sessionId}."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-build",
    "package-build": "node build.js --production",
    "compile": "tsc -b",
    "watch": "node build.js --watch",
    "package": "vsce package",
    "package:win": "vsce package --target win32-x64",
    "package:win-arm": "vsce package --target win32-arm64",
    "package:mac": "vsce package --target darwin-x64",
    "package:mac-arm": "vsce package --target darwin-arm64",
    "package:linux": "vsce package --target linux-x64",
    "package:linux-arm": "vsce package --target linux-arm64",
    "package:all": "npm run package:win && npm run package:win-arm && npm run package:mac && npm run package:mac-arm && npm run package:linux && npm run package:linux-arm",
    "publish": "vsce publish",
    "test": "jest",
    "lint": "eslint . --ext .ts"
  },
  "author": "WayLog Team",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@vscode/sqlite3": "^5.1.10-vscode"
  }
}
